# Environment Configuration for Wegym
# Copy this file to .env and fill in the values below
# Most of these are loaded via next.config.ts with NEXT_PUBLIC_ prefix for client access

# === Core Application ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-very-secure-secret-key
NODE_ENV=development

# === Database ===
DATABASE_URL=postgresql://postgres:password@localhost:5432/wegym

# === Bundle Analyzer ===
# Set to "true" to analyze bundle: ANALYZE=true next build
ANALYZE=false

# === Sentry (Error Monitoring & Performance) ===
# Create a Sentry account at https://sentry.io and get your DSN
NEXT_PUBLIC_SENTRY_DSN=https://o123456.ingest.sentry.io/87654321
SENTRY_DSN=https://o123456.ingest.sentry.io/87654321
SENTRY_TRACES_SAMPLE_RATE=0.1

# === Payment Gateways ===
# MercadoPago
MP_ACCESS_TOKEN=your_mercado_pago_access_token
MP_WEBHOOK_SECRET=your_mercado_pago_webhook_secret
NEXT_PUBLIC_MP_PUBLIC_KEY=your_mercado_pago_public_key

# Google OAuth Integrations
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=https://your-domain.com/api/integrations/strava/callback

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/integrations/google-fit/callback

# Token Encryption (for integration secrets)
TOKEN_ENCRYPTION_KEY=wegym-token-secret-key-change-in-production

# === Email Service ===
# Resend for transactional emails
RESEND_API_KEY=your_resend_api_key

# === Security ===
CSRF_SECRET=change-this-to-a-secure-csrf-secret
# CSRF_TOKEN is generated dynamically if not set

# === Google Generative AI ===
GEMINI_API_KEY=your_google_gemini_api_key

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Mobile (Expo) ===
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key